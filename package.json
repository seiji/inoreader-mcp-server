{
  "name": "inoreader-mcp-server",
  "version": "0.4.1",
  "description": "MCP Server for Inoreader RSS feed management",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "inoreader-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.1.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "inoreader",
    "rss",
    "llm",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seiji/inoreader-mcp-server.git"
  }
}
